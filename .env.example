# ═══════════════════════════════════════════════════════════════
# Banking Leads Management Platform — Environment Configuration
# Copy this file to .env and fill in your values
# ═══════════════════════════════════════════════════════════════

# ─── Backend ───────────────────────────────────────────────────
NODE_ENV=production
PORT=3000

# MongoDB connection string
# Local:      mongodb://127.0.0.1:27017/banking-leads
# Docker:     mongodb://mongo:27017/banking-leads        (internal container network)
# Atlas:      mongodb+srv://<user>:<password>@cluster.mongodb.net/banking-leads
MONGODB_URI=mongodb://127.0.0.1:27017/banking-leads

# ─── Docker Port Assignments (on Hostinger VPS) ────────────────
# Frontend  → http://YOUR_VPS_IP:87
# Backend   → http://YOUR_VPS_IP:5007
# MongoDB   → YOUR_VPS_IP:27023  (internal only — do NOT expose publicly)

# ─── GitHub Actions / CI-CD Secrets ────────────────────────────
# Set these in: GitHub → Settings → Secrets and variables → Actions
#
# GITHUB_TOKEN     (auto-provided by GitHub Actions, no setup needed)
# SERVER_HOST      IP address or domain of your production server
# SERVER_USER      SSH username (e.g. ubuntu, ec2-user, root)
# SERVER_SSH_KEY   Private SSH key for server authentication
# SERVER_PORT      SSH port (default: 22)
